# 环境与密钥（勿提交）
.env
.env.local
*.pem

# 输出目录
output/

# 审计日志（按 user_id / 日期分片）
logs/
logs_*.log

# 本地隧道工具
ngrok.exe

# 本地 SQLite 数据库
*.db

# Python
__pycache__/
*.py[cod]
*.egg-info/
.eggs/
.venv/
venv/
.env/

# IDE
.idea/
.vscode/
*.swp
*.swo

# 系统
.DS_Store
Thumbs.db

# 本地工具运行时产物
.omx/
as.log
verdict_out.json
venv311/
logs_*_err.log

# 第三方源码副本 vendor/xiaozhi-esp32-server (作为源码维护入 git)
# 仅排除 .venv 和 models (重建/下载即可)
vendor/xiaozhi-esp32-server/main/xiaozhi-server/.venv/
vendor/xiaozhi-esp32-server/main/xiaozhi-server/models/
# 含敏感凭据的文件 (强制排除, 防止 push 泄密)
vendor/**/.config.yaml
vendor/**/.secrets.yaml
vendor/**/.private_config.yaml
vendor/**/.env
vendor/**/.env.development
# 例外: manager-mobile 的 env 是公共构建配置, 不含密钥, 保留入 git (上游也保留)
!vendor/xiaozhi-esp32-server/main/manager-mobile/**/env/
!vendor/xiaozhi-esp32-server/main/manager-mobile/**/.env*
# 标准构建产物 (不是源码)
vendor/**/__pycache__/
vendor/**/node_modules/
vendor/**/*.pyc
