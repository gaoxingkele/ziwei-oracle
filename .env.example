# 复制为 .env 并填入 API Key
# 通过 LLM_PROVIDER 切换 Provider（当前 CLI 默认使用 kimi）

# 默认 Provider: kimi | openai | grok | perplexity | claude | gemini
LLM_PROVIDER=kimi

# ===== Kimi（月之暗面） =====
# https://platform.moonshot.cn
KIMI_API_KEY=
KIMI_BASE_URL=https://api.moonshot.cn/v1
KIMI_MODEL=kimi-k2-turbo-preview
KIMI_VISION_MODEL=moonshot-v1-32k-vision-preview

# ===== OpenAI（ChatGPT） =====
# https://platform.openai.com
OPENAI_API_KEY=
OPENAI_BASE_URL=https://api.openai.com/v1
OPENAI_MODEL=gpt-4o-mini

# ===== xAI（Grok） =====
# https://x.ai
GROK_API_KEY=
GROK_BASE_URL=https://api.x.ai/v1
GROK_MODEL=grok-2

# ===== Perplexity =====
# https://www.perplexity.ai/settings/api
PERPLEXITY_API_KEY=
PERPLEXITY_BASE_URL=https://api.perplexity.ai
PERPLEXITY_MODEL=sonar

# ===== Anthropic（Claude） =====
# https://console.anthropic.com
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-3-5-sonnet-20241022

# ===== Google（Gemini） =====
# https://aistudio.google.com
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-pro

# ===== 西方星相学（kerykeion）默认地点配置（离线排盘） =====
# 可按用户所在地调整，提升宫位/上升准确性
ASTRO_CITY=Beijing
ASTRO_NATION=CN
ASTRO_LNG=116.4074
ASTRO_LAT=39.9042
ASTRO_TZ_STR=Asia/Shanghai

# ---- Database ----
DATABASE_URL=postgresql+asyncpg://oracle:oracle123@localhost:5432/ds_oracle
REDIS_URL=redis://localhost:6379/0

# ---- JWT ----
JWT_SECRET=change-me-in-production
JWT_ACCESS_EXPIRE_MINUTES=120
JWT_REFRESH_EXPIRE_DAYS=7

# ---- CORS ----
CORS_ORIGINS=*
