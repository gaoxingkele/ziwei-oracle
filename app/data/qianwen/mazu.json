[
  {
    "number": 1,
    "ganzhi": "甲子",
    "level": "",
    "poem": "日出便见浮云散，光明清洁照世间。一向前途通大道，和合清吉万事安。",
    "interpretation": "",
    "story": ""
  },
  {
    "number": 2,
    "ganzhi": "乙丑",
    "level": "",
    "poem": "云开日出见分明，不须进退问前程。婚姻总是天注定，百般清吉万事成。",
    "interpretation": "",
    "story": ""
  },
  {
    "number": 3,
    "ganzhi": "丙寅",
    "level": "",
    "poem": "财中渐渐见分明，花开花谢结子成。宽心且看月中后，郎君即便见太平。",
    "interpretation": "",
    "story": ""
  },
  {
    "number": 4,
    "ganzhi": "丁卯",
    "level": "",
    "poem": "前途求名莫望高，只恐后事未还和。内中必定逢损失，劝君且退莫心劳。",
    "interpretation": "",
    "story": ""
  },
  {
    "number": 5,
    "ganzhi": "戊辰",
    "level": "",
    "poem": "君汝宽心暂遨游，家门清吉永无忧。命裹终然逢大吉，凡事无伤不须求。",
    "interpretation": "",
    "story": ""
  },
  {
    "number": 6,
    "ganzhi": "己巳",
    "level": "",
    "poem": "欲去江水白茫茫，行船保定未遭风。户内同心再作福，看看鱼水得相逢。",
    "interpretation": "",
    "story": ""
  },
  {
    "number": 7,
    "ganzhi": "庚午",
    "level": "",
    "poem": "各登禄位与高显，前途遇贵自安然。若逢一轮明月现，十五团圆照满天。",
    "interpretation": "",
    "story": ""
  },
  {
    "number": 8,
    "ganzhi": "辛未",
    "level": "",
    "poem": "枯木渐渐逢春雨，雨足园林再生枝。看看梅花开过后，不须求名录自安。",
    "interpretation": "",
    "story": ""
  },
  {
    "number": 9,
    "ganzhi": "壬申",
    "level": "",
    "poem": "有心作事莫迟疑，求名求利正当时。其中必定终和合，财宝自然庆有余。",
    "interpretation": "",
    "story": ""
  },
  {
    "number": 10,
    "ganzhi": "癸酉",
    "level": "",
    "poem": "风云致雨落常常，天灾时气必有伤。内中此事难和合，相逢必定出外乡。",
    "interpretation": "",
    "story": ""
  },
  {
    "number": 11,
    "ganzhi": "甲戌",
    "level": "",
    "poem": "前江渐渐风浪静，如今仁政可安民。还有贵人相助力，凡事脱出见清平。",
    "interpretation": "",
    "story": ""
  },
  {
    "number": 12,
    "ganzhi": "乙亥",
    "level": "",
    "poem": "用尽心机总是休，路途正遇孛罗关。问神作福难得遇，恰似行船上高山。",
    "interpretation": "",
    "story": ""
  },
  {
    "number": 13,
    "ganzhi": "丙子",
    "level": "",
    "poem": "富贵总是天注定，心虚必定误君身。不如且回依旧路，云开日出见分明。",
    "interpretation": "",
    "story": ""
  },
  {
    "number": 14,
    "ganzhi": "丁丑",
    "level": "",
    "poem": "选出牡丹第一枝。劝君长短莫迟疑。若问世间和合事，万物逢春正及时。",
    "interpretation": "",
    "story": ""
  },
  {
    "number": 15,
    "ganzhi": "戊寅",
    "level": "",
    "poem": "狼虎相逐在门前，此事到底有相遇。若问世间难和合，万事逢春正及时。",
    "interpretation": "",
    "story": ""
  },
  {
    "number": 16,
    "ganzhi": "己卯",
    "level": "",
    "poem": "意中若要求仙路，人心且退莫望望。宽心自有宽心福，终遇贵人逢得多。",
    "interpretation": "",
    "story": ""
  },
  {
    "number": 17,
    "ganzhi": "庚辰",
    "level": "",
    "poem": "花开必定成花果，富贵荣华终到老。命逢君子自成长，凡事清吉莫烦恼。",
    "interpretation": "",
    "story": ""
  },
  {
    "number": 18,
    "ganzhi": "辛巳",
    "level": "",
    "poem": "虎落平阳受犬欺，心中反复有谁知？但凡诸事任君手，只恐前途误君机。",
    "interpretation": "",
    "story": ""
  },
  {
    "number": 19,
    "ganzhi": "壬午",
    "level": "",
    "poem": "蛇心意欲变成龙，只恐万般事几重。久病且作宽心早，言语多端不可从。",
    "interpretation": "",
    "story": ""
  },
  {
    "number": 20,
    "ganzhi": "癸未",
    "level": "",
    "poem": "只恐前途有变迁，劝君作事可宜先。但过长江无大事，命逢遇贵喜万千。",
    "interpretation": "",
    "story": ""
  },
  {
    "number": 21,
    "ganzhi": "甲申",
    "level": "",
    "poem": "灵鸡渐渐叫分明，凡事但看子丑寅。云开日出满天下，郎君即便见太平。",
    "interpretation": "",
    "story": ""
  },
  {
    "number": 22,
    "ganzhi": "乙酉",
    "level": "",
    "poem": "若问中间此原因，看看禄马向前程。不求贵人终得利，和合清吉万事成。",
    "interpretation": "",
    "story": ""
  },
  {
    "number": 23,
    "ganzhi": "丙戌",
    "level": "",
    "poem": "日出光辉四海明，前途禄位见太平。风云退去终无事，危歹祸患不临身。",
    "interpretation": "",
    "story": ""
  },
  {
    "number": 24,
    "ganzhi": "丁亥",
    "level": "",
    "poem": "总是命运莫身劳，求神问佛枉奔波。看看鸡猴日过后，不须求福事如何。",
    "interpretation": "",
    "story": ""
  },
  {
    "number": 25,
    "ganzhi": "戊子",
    "level": "",
    "poem": "绿柳苍苍正遇春，任君如意作乾坤。花果结成无残树，福禄自有庆家门。",
    "interpretation": "",
    "story": ""
  },
  {
    "number": 26,
    "ganzhi": "己丑",
    "level": "",
    "poem": "明显有意在中间，不须求名禄自安。看看早晚日过后，花发苍苍似牡丹。",
    "interpretation": "",
    "story": ""
  },
  {
    "number": 27,
    "ganzhi": "庚寅",
    "level": "",
    "poem": "东西南北不堪行，前途此事正当停。须是中间多进退，它舍自有保安宁。",
    "interpretation": "",
    "story": ""
  },
  {
    "number": 28,
    "ganzhi": "辛卯",
    "level": "",
    "poem": "克行前途须吉利，君汝何故两相疑。劝君且回终吉庆，月有光辉脱云时。",
    "interpretation": "",
    "story": ""
  },
  {
    "number": 29,
    "ganzhi": "壬辰",
    "level": "",
    "poem": "宽心保定莫烦连，到底清吉自安然。说起人间无大事，命逢太白随身边。",
    "interpretation": "",
    "story": ""
  },
  {
    "number": 30,
    "ganzhi": "癸巳",
    "level": "",
    "poem": "风平浪静可行航，胜过中秋月正圆。凡事不须多忧虑，福禄自有喜双全。",
    "interpretation": "",
    "story": ""
  },
  {
    "number": 31,
    "ganzhi": "甲午",
    "level": "",
    "poem": "黄花结子一半枯。但看今年运来苏。日落西山渐渐去，劝君不必问前途。",
    "interpretation": "",
    "story": ""
  },
  {
    "number": 32,
    "ganzhi": "乙未",
    "level": "",
    "poem": "旧帐重重来解尽，家中祸患不临身。户内用心再作福，龙蛇交会得和平。",
    "interpretation": "",
    "story": ""
  },
  {
    "number": 33,
    "ganzhi": "丙申",
    "level": "",
    "poem": "欲去长江阔茫茫，所求未遂运未通。但有丝纶常在手，看看鱼水得相逢。",
    "interpretation": "",
    "story": ""
  },
  {
    "number": 34,
    "ganzhi": "丁酉",
    "level": "",
    "poem": "渐渐看此月中和，事后相逢未得高。改变克行前途去，凡事必定见重牢。",
    "interpretation": "",
    "story": ""
  },
  {
    "number": 35,
    "ganzhi": "戊戌",
    "level": "",
    "poem": "福如东海寿如山，君汝何须苦中间。命裹终然逢大吉，所求分定禄自安。",
    "interpretation": "",
    "story": ""
  },
  {
    "number": 36,
    "ganzhi": "己亥",
    "level": "",
    "poem": "命逢得月似显迹，劝君心中保为一。一向前途无难事，福禄常有为清吉。",
    "interpretation": "",
    "story": ""
  },
  {
    "number": 37,
    "ganzhi": "庚子",
    "level": "",
    "poem": "一年作事紧如飞，君汝宽心莫致疑。佳人还在千里远，音信渐渐月中知。",
    "interpretation": "",
    "story": ""
  },
  {
    "number": 38,
    "ganzhi": "辛丑",
    "level": "",
    "poem": "佛中注定无二心，但看前途事同音。此心原来本是铁，也能变化得成金。",
    "interpretation": "",
    "story": ""
  },
  {
    "number": 39,
    "ganzhi": "壬寅",
    "level": "",
    "poem": "病中莫得苦心劳，到底终然总是空。是非不必转去问，必察其中有多端。",
    "interpretation": "",
    "story": ""
  },
  {
    "number": 40,
    "ganzhi": "癸卯",
    "level": "",
    "poem": "劝君保定莫须劳，天注福禄自有余。和合重重常吉利，命运遇贵得明珠。",
    "interpretation": "",
    "story": ""
  },
  {
    "number": 41,
    "ganzhi": "甲辰",
    "level": "",
    "poem": "狼虎相逐过远山，君汝莫作背后看。不知此意常受误，他人与汝却无干。",
    "interpretation": "",
    "story": ""
  },
  {
    "number": 42,
    "ganzhi": "乙巳",
    "level": "",
    "poem": "不须作福不须求，用尽心机总未休。阳间岂知阴间事，官法如炉不自由。",
    "interpretation": "",
    "story": ""
  },
  {
    "number": 43,
    "ganzhi": "丙午",
    "level": "",
    "poem": "太公家业八十成，日出光辉四海明。命裹终然逢大吉，末尾中间吉事兴。",
    "interpretation": "",
    "story": ""
  },
  {
    "number": 44,
    "ganzhi": "丁未",
    "level": "",
    "poem": "枯木可惜未逢春，如今且在暗中存。宽心且看霜雪过，劝君渐渐作乾坤。",
    "interpretation": "",
    "story": ""
  },
  {
    "number": 45,
    "ganzhi": "戊申",
    "level": "",
    "poem": "此事何须问君机，前途叹息自然知。远行必定终和合，凡事脱出得明时。",
    "interpretation": "",
    "story": ""
  },
  {
    "number": 46,
    "ganzhi": "己酉",
    "level": "",
    "poem": "一重江水一重山，谁知去后路有难。任他改求终未遇，还有是非事不安。",
    "interpretation": "",
    "story": ""
  },
  {
    "number": 47,
    "ganzhi": "庚戌",
    "level": "",
    "poem": "阴阳作事本和同，云遮日色正朦胧。心中意欲前途去，只恐前途路不通。",
    "interpretation": "",
    "story": ""
  },
  {
    "number": 48,
    "ganzhi": "辛亥",
    "level": "",
    "poem": "言语多端不可从，风云虽动未成龙。暗裹终然明消息，君汝何苦问重重。",
    "interpretation": "",
    "story": ""
  },
  {
    "number": 49,
    "ganzhi": "壬子",
    "level": "",
    "poem": "须是进退总虚空，看看发福未成缘。如玉深藏还未变，心中法则枉徒然。",
    "interpretation": "",
    "story": ""
  },
  {
    "number": 50,
    "ganzhi": "癸丑",
    "level": "",
    "poem": "日今此事正冬梅，看看欲吐百花魁。若能逢得春色到，一阵清风应晚回。",
    "interpretation": "",
    "story": ""
  },
  {
    "number": 51,
    "ganzhi": "甲寅",
    "level": "",
    "poem": "渐渐禾苗结实成，但凡作事定周全，宽心且守宜静坐，一时有应未当权。",
    "interpretation": "",
    "story": ""
  },
  {
    "number": 52,
    "ganzhi": "乙卯",
    "level": "",
    "poem": "八十原来是太公，看看尾末遇文王。目下紧事休相问，劝君宽心事一同。",
    "interpretation": "",
    "story": ""
  },
  {
    "number": 53,
    "ganzhi": "丙辰",
    "level": "",
    "poem": "十方神佛在法论，有难祸患作乾坤。红日当门常照耀，还有贵人护家门。",
    "interpretation": "",
    "story": ""
  },
  {
    "number": 54,
    "ganzhi": "丁巳",
    "level": "",
    "poem": "如今莫作此当时，虎落平原受犬欺。世世反常无定准，千山万水也迟疑。",
    "interpretation": "",
    "story": ""
  },
  {
    "number": 55,
    "ganzhi": "戊午",
    "level": "",
    "poem": "危险高山行得过，莫问此路又重重。若见桂花渐渐发，毒蛇反转变成龙。",
    "interpretation": "",
    "story": ""
  },
  {
    "number": 56,
    "ganzhi": "己未",
    "level": "",
    "poem": "令人到手实难捱，高歌畅饮自徘徊。鸡犬相闻消息通，婚缘夙世不须媒。",
    "interpretation": "",
    "story": ""
  },
  {
    "number": 57,
    "ganzhi": "庚申",
    "level": "",
    "poem": "何须用意问圣迹，自己心中保为益。劝君且看此中句，凡事脱出见清吉。",
    "interpretation": "",
    "story": ""
  },
  {
    "number": 58,
    "ganzhi": "辛酉",
    "level": "",
    "poem": "孤灯寂寂夜沉沉，烧得清香供神明。若问世间有善果，百般清吉万事成。",
    "interpretation": "",
    "story": ""
  },
  {
    "number": 59,
    "ganzhi": "壬戌",
    "level": "",
    "poem": "日出看看本清吉，浮云忽然行千里。内中必定人有厄，用心祈福代成全。",
    "interpretation": "",
    "story": ""
  },
  {
    "number": 60,
    "ganzhi": "癸亥",
    "level": "",
    "poem": "求签猜签谈这签，今兹团圆大吉昌；虔诚为祝家国事，后我后来载史篇。",
    "interpretation": "",
    "story": ""
  }
]