# ===========================================================
# 本机开发环境配置（拷贝为 .env.local 使用，已被 .gitignore 忽略）
#
# 加载优先级：
#   存在 .env.local → 加载 .env.local（本机调试用）
#   否则           → 加载 .env       （云端线上用）
#
# 三处 dotenv 入口都遵循此规则：mcp_server.py / config.py / app/config.py
# 切回云端模式：删除或重命名 .env.local 即可。
# ===========================================================

# ===== API Token（设备端 / REST 调用用，本机随便填）=====
API_TOKENS=local-dev-token

# ===== LLM Provider =====
LLM_PROVIDER=kimi
KIMI_API_KEY=
KIMI_MODEL=kimi-k2-turbo-preview
KIMI_VISION_MODEL=moonshot-v1-32k-vision-preview

# 其他厂商按需填
OPENAI_API_KEY=
GEMINI_API_KEY=
PERPLEXITY_API_KEY=
ANTHROPIC_API_KEY=

# ===== 设置存储数据库 =====
# 本机用 SQLite 零依赖，文件落到项目根 ds_oracle_local.db
SETTINGS_DB_URL=sqlite+aiosqlite:///./ds_oracle_local.db

# 主业务数据库（如需要 PG，改成 postgresql+asyncpg://...）
DATABASE_URL=sqlite+aiosqlite:///./ds_oracle_local.db
REDIS_URL=redis://localhost:6379/0

# ===== JWT（本机随便）=====
JWT_SECRET=local-dev-secret-change-me
JWT_ACCESS_EXPIRE_MINUTES=120
JWT_REFRESH_EXPIRE_DAYS=7

# ===== CORS =====
CORS_ORIGINS=*

# ===== 西方占星默认地点 =====
ASTRO_CITY=Beijing
ASTRO_NATION=CN
ASTRO_LNG=116.4074
ASTRO_LAT=39.9042
ASTRO_TZ_STR=Asia/Shanghai

# ===== 单设备调试便捷项 =====
# 设备端忘传 device_id 时，服务端用此 ID 兜底，避免每次手动指定
# MCP_USER_ID=mcp_dev_local
